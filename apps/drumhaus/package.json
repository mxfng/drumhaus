    "@haus/ui": "workspace:*",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-form": "^0.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "fflate": "^0.8.3",
    "framer-motion": "^12.40.0",
    "immer": "^11.1.8",
    "lucide-react": "^1.21.0",
    "pako": "^2.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "tone": "15.5.25",
